# Copy to .env at the project root before running `docker compose up`.
#
# Note: docker-compose.yml already overrides DATABASE_URL, REDIS_URL, and
# CHROMA_HOST/PORT for the backend and worker containers directly (they need
# to point at the other containers by service name, not localhost) — those
# three values here only matter if you run the backend natively
# (`uvicorn app.main:app`) outside Docker, where the defaults in
# backend/app/config.py already point at localhost/SQLite and this file is
# optional for a pure-local run.

# --- app ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# --- database (native/non-Docker default shown; Docker overrides this) ---
DATABASE_URL=sqlite+aiosqlite:///./businessos.db

# --- redis / celery (native/non-Docker default shown; Docker overrides this) ---
REDIS_URL=redis://localhost:6379/0

# --- vector db (native/non-Docker default shown; Docker overrides this) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- auth ---
# Generate a real value before anything but local dev: `openssl rand -hex 32`
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
# No paid API key is required to run the project — Ollama is the default and
# runs locally. Cloud providers are opt-in behind the same LLMClient interface.
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
